# Supabase (Settings > API in your Supabase dashboard)
SUPABASE_URL=https://kerlookffyyascxyubqs.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Gmail SMTP (Google Account > Security > App Passwords)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where demo request notifications are sent
NOTIFICATION_EMAIL=anastasiades.chr@gmail.com

# Survey (/survey/240526): Google Apps Script web-app URL that appends rows to your Sheet
